@model EDSOM.Models.PasswordTemporalViewModel
@{
    ViewData["Title"] = "Contraseña temporal";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-3">@(Model.EsNueva ? "Contraseña regenerada" : "Contraseña temporal")</h3>

                <p class="mb-1"><strong>Funcionario:</strong> @(Model.NombreCompleto ?? "—")</p>
                <p class="mb-3"><strong>Usuario (cédula):</strong> @Model.NombreUsuario</p>

                <div class="text-center bg-light border rounded py-3 mb-3">
                    <div class="text-muted small">Contraseña temporal</div>
                    <div class="fs-2 fw-bold font-monospace user-select-all">@Model.Password</div>
                </div>

                <div class="alert alert-warning small">
                    Entregue esta contraseña al funcionario ahora para que la anote. En su primer ingreso el sistema le
                    pedirá cambiarla y, una vez cambiada, ya no podrá consultarse aquí.
                </div>

                <a asp-action="Index" class="btn btn-primary">Volver a usuarios</a>
            </div>
        </div>
    </div>
</div>
