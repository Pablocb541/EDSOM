@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="text-center mb-0">EDSOM</h3>
                <p class="text-center text-muted small mb-4">Expediente Digital de Salud Ocupacional Municipal</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label for="nombreUsuario" class="form-label">Usuario (cédula)</label>
                        <input id="nombreUsuario" name="nombreUsuario" class="form-control" autocomplete="username" autofocus required />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña</label>
                        <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                </form>

                <div class="alert alert-info small mt-4 mb-0">
                    <strong>¿Primer ingreso?</strong> Use la contraseña temporal que le entregó el administrador.
                    Por seguridad, el sistema le pedirá cambiarla antes de continuar.
                </div>
            </div>
        </div>
    </div>
</div>
